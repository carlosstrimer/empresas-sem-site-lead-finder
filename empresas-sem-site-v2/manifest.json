{
  "manifest_version": 3,
  "name": "Empresas Sem Site — Leads",
  "version": "2.0.0",
  "description": "Pesquisa e organiza oportunidades do Google Maps, OpenStreetMap e exportações do EmpresAqui.",
  "permissions": ["storage", "tabs", "scripting", "unlimitedStorage"],
  "host_permissions": ["https://www.google.com/maps/*", "https://maps.google.com/*", "https://overpass-api.de/api/*", "https://overpass.private.coffee/api/*", "https://www.empresaqui.com.br/acesso/RetornoJson.php*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Empresas Sem Site" }
}
